# Copy this file to config.env before deployment when defaults need changing.
# This file must never contain LIGHTOPS_API_TOKEN or any other secret.

# Public Nginx listener. Uvicorn always stays on 127.0.0.1:8000.
LIGHTOPS_PUBLIC_PORT=8080
LIGHTOPS_SERVER_NAME=_
LIGHTOPS_PUBLIC_HOST=SERVER_IP

# auto reads local DMI identity only; no cloud metadata network is queried.
LIGHTOPS_CLOUD_PROVIDER=auto

# 1 lets install.sh use the detected apt-get/dnf/yum package manager.
LIGHTOPS_INSTALL_PACKAGES=1

# auto detects installed systemd units. Use none to exclude an optional service,
# or provide an exact installed unit name without the .service suffix.
LIGHTOPS_NGINX_SERVICE=auto
LIGHTOPS_MYSQL_SERVICE=auto
LIGHTOPS_REDIS_SERVICE=auto

# Swap is deliberately opt-in. Setting this to 1 authorizes creation of
# /swapfile only when the host currently has no active Swap.
LIGHTOPS_ENABLE_SWAP=0
LIGHTOPS_SWAP_SIZE=2G
