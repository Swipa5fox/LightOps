# LightOps 首次部署配置模板
#
# 用法：
#   cp config.env.example config.env
# 然后只取消注释真正需要修改的行。全部保持注释时，等价于不创建 config.env，
# 安装器使用内置默认值。
#
# install.sh 会在启动时 source 本文件（set -a），其中显式设置的值会覆盖外部
# 传入的同名环境变量。升级时尤其注意 LIGHTOPS_INSTALL_PACKAGES 与
# LIGHTOPS_ENABLE_SWAP：一旦在这里显式设为 1，升级脚本传入的 0 会被盖掉。
#
# 各取值的合法性由 install.sh 的 validate_configuration() 强制校验，
# 非法值会中止安装而不是静默忽略。

# 对外监听端口。整数，1-65535，不得为 8000（与 Uvicorn 私有监听端口冲突）。
#LIGHTOPS_PUBLIC_PORT=8080

# Nginx server_name。允许 A-Za-z0-9._*-
#LIGHTOPS_SERVER_NAME=_

# 对外主机名或 IP。允许 A-Za-z0-9._:-
#LIGHTOPS_PUBLIC_HOST=SERVER_IP

# 云厂商标识。auto 表示自动探测；手工指定时不得包含单引号。
#LIGHTOPS_CLOUD_PROVIDER=auto

# 是否由安装器安装系统依赖包。取值 0 或 1。
# 升级场景建议显式设为 0，避免改动系统包。
#LIGHTOPS_INSTALL_PACKAGES=1

# 受监控的 systemd 服务名。auto 表示自动探测，未安装的候选会被忽略。
# Nginx 候选：nginx
# MySQL/MariaDB 候选：mysqld、mysql、mariadb
# Redis 候选：redis、redis-server
#LIGHTOPS_NGINX_SERVICE=auto
#LIGHTOPS_MYSQL_SERVICE=auto
#LIGHTOPS_REDIS_SERVICE=auto

# 是否创建 Swap。取值 0 或 1。
# 创建 Swap 属于系统级变更，需先取得明确授权。
#LIGHTOPS_ENABLE_SWAP=0

# Swap 大小。格式为 <数字>M 或 <数字>G，例如 512M、2G。
# 仅当 LIGHTOPS_ENABLE_SWAP=1 时生效。
#LIGHTOPS_SWAP_SIZE=2G

# LIGHTOPS_SERVICES 不在此处配置。它由安装器写入 /etc/lightops/lightops.env，
# 升级时会自动保留既有值；在这里手工指定会干扰该保留逻辑。
